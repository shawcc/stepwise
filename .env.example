# Any OpenAI-compatible model provider can power collaborative Agent Runs.
WORKGRAPH_AI_API_KEY=
WORKGRAPH_AI_BASE_URL=https://api.openai.com/v1
WORKGRAPH_AI_MODEL=gpt-4.1-mini

# Required in production. Protects the Web app and every API route.
# Use a unique, high-entropy value and never expose it with a VITE_ prefix.
STEPWISE_ACCESS_CODE=

# Required for MCP write tools. Use a long random value in deployed environments.
STEPWISE_MCP_WRITE_TOKEN=

# Optional comma-separated origins allowed to call /api/mcp from browsers.
STEPWISE_MCP_ALLOWED_ORIGINS=

# Server-only Supabase persistence. Use the project's secret key, never a
# publishable/anon key, and never expose either value with a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional logical workspace row identifier. Defaults to "default".
STEPWISE_WORKSPACE_ID=default
